
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Shared image validation
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // User profile pictures and banners
    match /users/{uid}/profile/{fileName} {
      allow read: if true;
      allow create, update: if owns(uid) && validImage();
      allow delete: if owns(uid);
    }

    // Creator portfolio images
    match /users/{uid}/portfolio/{fileName} {
      allow read: if true;
      allow create, update: if owns(uid) && validImage();
      allow delete: if owns(uid);
    }

    // Community post images
    match /users/{uid}/posts/{postId} {
      allow read: if true;
      allow create, update: if owns(uid) && validImage();
      allow delete: if owns(uid);
    }

    // Marketplace product images
    match /users/{uid}/products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if owns(uid) && validImage();
      allow delete: if owns(uid);
    }

    // Creative request reference images
    match /users/{uid}/requests/{requestId}/{fileName} {
      allow read: if true;
      allow create, update: if owns(uid) && validImage();
      allow delete: if owns(uid);
    }
  }
}
